{
  "name": "@dynobox/run-schema",
  "version": "0.0.0",
  "description": "Shared Dynobox run upload schema and types",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --splitting false --clean && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "author": "dynobox (https://dynobox.xyz)",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "vitest": "^4.0.10"
  }
}

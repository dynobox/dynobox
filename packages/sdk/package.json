{
  "name": "@dynobox/sdk",
  "version": "0.2.0",
  "description": "Dynobox SDK for authoring scenario configs",
  "keywords": [
    "agent",
    "testing",
    "llm",
    "evals",
    "sdk"
  ],
  "homepage": "https://dynobox.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynobox/dynobox.git",
    "directory": "packages/sdk"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./ir": {
      "types": "./dist/ir.d.ts",
      "import": "./dist/ir.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/compiler.ts src/ir.ts --format esm --splitting false --clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "author": "dynobox (https://dynobox.xyz)",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}

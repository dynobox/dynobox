{
  "name": "dynobox",
  "version": "0.4.0",
  "description": "Cross-harness testing for multi-step agent and skill workflows",
  "keywords": [
    "agent",
    "testing",
    "llm",
    "claude-code",
    "codex",
    "evals"
  ],
  "homepage": "https://dynobox.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynobox/dynobox.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --noEmit",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "author": "dynobox (https://dynobox.xyz)",
  "bin": {
    "dynobox": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@dynobox/run-schema": "workspace:*",
    "@dynobox/sdk": "workspace:*",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "mockttp": "^4.4.1",
    "tinyglobby": "^0.2.16",
    "tsx": "^4.21.0",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@dynobox/evaluators": "workspace:*",
    "@dynobox/runner-local": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}

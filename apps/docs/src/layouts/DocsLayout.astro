---
import type { DocNavItem, DocPage } from '../lib/docs';
import '../styles/docs.css';

type Props = {
  navItems: DocNavItem[];
  page: DocPage;
};

const { navItems, page } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta
      name="description"
      content="Dynobox documentation for local agent and skill workflow testing."
    />
    <script is:inline>
      (() => {
        const storageKey = 'dynobox-docs-theme';
        const root = document.documentElement;
        const stored = localStorage.getItem(storageKey);
        const system = window.matchMedia('(prefers-color-scheme: light)')
          .matches
          ? 'light'
          : 'dark';
        root.dataset.theme = stored === 'light' || stored === 'dark'
          ? stored
          : system;
      })();
    </script>
    <title>{page.title} | Dynobox Docs</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="https://dynobox.xyz" aria-label="Dynobox home">
        <span class="brand-mark">dynobox</span>
        <span class="brand-section">docs</span>
      </a>
      <div class="top-actions">
        <nav class="topnav" aria-label="External navigation">
          <a href="https://github.com/dynobox/dynobox" target="_blank"
            >GitHub</a
          >
          <a href="https://www.npmjs.com/package/dynobox" target="_blank"
            >npm</a
          >
        </nav>
        <button
          class="theme-toggle"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label="Use light mode"
          title="Switch theme"
        >
          <span class="theme-toggle-track" aria-hidden="true">
            <span class="theme-toggle-option theme-toggle-option-dark">
              <svg
                class="theme-toggle-icon theme-toggle-moon"
                width="12"
                height="13"
                viewBox="0 0 12 13"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M11.3764 9.04656C11.2112 9.06022 11.0441 9.06718 10.8754 9.06718C7.56173 9.06718 4.87549 6.38093 4.87549 3.06728C4.87549 1.94653 5.18278 0.897541 5.71771 0C2.52866 0.186293 0 2.83147 0 6.06725C0 9.42391 2.7211 12.145 6.07776 12.145C8.35189 12.145 10.3343 10.896 11.3764 9.04656Z"
                  fill="currentColor"></path>
              </svg>
            </span>
            <span class="theme-toggle-option theme-toggle-option-light">
              <svg
                class="theme-toggle-icon theme-toggle-sun"
                width="17"
                height="16"
                viewBox="0 0 17 16"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle cx="8.79932" cy="8" r="4" fill="currentColor"
                ></circle>
                <circle class="ray" cx="8.79932" cy="1" r="1" fill="currentColor"
                ></circle>
                <circle class="ray" cx="8.79932" cy="15" r="1" fill="currentColor"
                ></circle>
                <circle class="ray" cx="1.79932" cy="8" r="1" fill="currentColor"
                ></circle>
                <circle class="ray" cx="15.7993" cy="8" r="1" fill="currentColor"
                ></circle>
                <circle
                  class="ray"
                  cx="3.84927"
                  cy="3.05078"
                  r="1"
                  fill="currentColor"></circle>
                <circle
                  class="ray"
                  cx="13.7487"
                  cy="12.9503"
                  r="1"
                  fill="currentColor"></circle>
                <circle
                  class="ray"
                  cx="3.84961"
                  cy="12.9491"
                  r="1"
                  fill="currentColor"></circle>
                <circle
                  class="ray"
                  cx="13.749"
                  cy="3.04957"
                  r="1"
                  fill="currentColor"></circle>
              </svg>
            </span>
            <span class="theme-toggle-thumb"></span>
          </span>
        </button>
      </div>
    </header>

    <div class="mobile-nav">
      <label for="doc-page">Page</label>
      <select id="doc-page" onchange="window.location.href = this.value">
        {
          navItems.map((item) => (
            <option value={item.route} selected={item.route === page.route}>
              {item.title}
            </option>
          ))
        }
      </select>
    </div>

    <div class="shell">
      <aside class="sidebar">
        <nav aria-label="Docs navigation">
          {
            navItems.map((item) => (
              <div class="sidebar-item">
                <a
                  class:list={[
                    'sidebar-link',
                    { active: item.route === page.route },
                  ]}
                  href={item.route}
                  aria-current={item.route === page.route ? 'page' : undefined}
                >
                  {item.title}
                </a>
                {item.route === page.route && page.headings.length > 0 && (
                  <div class="sidebar-nested">
                    {page.headings.map((heading) => (
                      <a
                        class:list={[
                          'sidebar-heading',
                          `level-${heading.level}`,
                        ]}
                        href={`#${heading.id}`}
                      >
                        {heading.title}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </nav>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>
    <script is:inline>
      (() => {
        const storageKey = 'dynobox-docs-theme';
        const root = document.documentElement;
        const button = document.querySelector('.theme-toggle');
        if (!(button instanceof HTMLButtonElement)) return;

        const syncLabel = () => {
          const isLight = root.dataset.theme === 'light';
          button.setAttribute('aria-checked', String(isLight));
          button.setAttribute(
            'aria-label',
            isLight ? 'Use dark mode' : 'Use light mode',
          );
          button.title = isLight ? 'Use dark mode' : 'Use light mode';
        };

        syncLabel();
        button.addEventListener('click', () => {
          document.body.style.transition =
            'color 400ms ease, background 300ms ease';
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          localStorage.setItem(storageKey, next);
          syncLabel();
        });
      })();
    </script>
  </body>
</html>

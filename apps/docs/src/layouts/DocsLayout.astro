---
import type { DocNavItem, DocPage } from '../lib/docs';
import '../styles/docs.css';

type Props = {
  navItems: DocNavItem[];
  page: DocPage;
};

const { navItems, page } = Astro.props;
const canonicalUrl = new URL(page.route, Astro.site).toString();
const markdownUrl = new URL(page.markdownRoute, Astro.site).toString();
const llmsUrl = new URL('/llms.txt', Astro.site).toString();
const docsIndexUrl = new URL('/docs-index.json', Astro.site).toString();
const previewImageUrl = new URL('/link-preview.png', Astro.site).toString();
const documentTitle =
  page.title === 'Dynobox Docs' ? page.title : `${page.title} | Dynobox Docs`;
const llmCopyText = [
  `# ${page.title}`,
  '',
  `Canonical URL: ${canonicalUrl}`,
  `Markdown URL: ${markdownUrl}`,
  `Source: ${page.sourceUrl}`,
  `Topics: ${page.topics.join(', ')}`,
  '',
  page.source.trim(),
].join('\n');
const llmCopyJson = JSON.stringify(llmCopyText).replaceAll('<', '\\u003c');
const webMcpContext = JSON.stringify({
  pages: navItems.map((item) => {
    const markdownRoute =
      item.route === '/' ? '/README.md' : `${item.route.replace(/\/$/, '')}.md`;

    return {
      route: item.route,
      title: item.title,
      markdownRoute,
    };
  }),
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/markdown" href={markdownUrl} />
    <link rel="alternate" type="text/plain" title="LLMs" href={llmsUrl} />
    <link
      rel="alternate"
      type="application/json"
      title="Docs index"
      href={docsIndexUrl}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta
      name="description"
      content={page.description}
    />
    <meta name="docsearch:package" content="dynobox" />
    <meta name="docsearch:sdk-package" content="@dynobox/sdk" />
    <meta name="docsearch:topics" content={page.topics.join(', ')} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={page.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="dynobox | docs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={previewImageUrl} />
    <script is:inline>
      (() => {
        const storageKey = 'dynobox-docs-theme';
        const root = document.documentElement;
        const stored = localStorage.getItem(storageKey);
        const system = window.matchMedia('(prefers-color-scheme: light)')
          .matches
          ? 'light'
          : 'dark';
        root.dataset.theme = stored === 'light' || stored === 'dark'
          ? stored
          : system;
      })();
    </script>
    <title>{documentTitle}</title>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="https://dynobox.xyz" aria-label="Dynobox home">
          <span class="brand-mark">dynobox</span>
          <span class="brand-section">docs</span>
        </a>
        <div class="topbar-content">
          <div class="top-actions">
            <nav class="topnav" aria-label="External navigation">
              <a href="https://github.com/dynobox/dynobox" target="_blank"
                >GitHub</a
              >
              <a href="https://www.npmjs.com/package/dynobox" target="_blank"
                >npm</a
              >
            </nav>
            <button
              class="theme-toggle"
              type="button"
              role="switch"
              aria-checked="false"
              aria-label="Use light mode"
              title="Switch theme"
            >
              <span class="theme-toggle-track" aria-hidden="true">
                <span class="theme-toggle-option theme-toggle-option-dark">
                  <svg
                    class="theme-toggle-icon theme-toggle-moon"
                    width="12"
                    height="13"
                    viewBox="0 0 12 13"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M11.3764 9.04656C11.2112 9.06022 11.0441 9.06718 10.8754 9.06718C7.56173 9.06718 4.87549 6.38093 4.87549 3.06728C4.87549 1.94653 5.18278 0.897541 5.71771 0C2.52866 0.186293 0 2.83147 0 6.06725C0 9.42391 2.7211 12.145 6.07776 12.145C8.35189 12.145 10.3343 10.896 11.3764 9.04656Z"
                      fill="currentColor"></path>
                  </svg>
                </span>
                <span class="theme-toggle-option theme-toggle-option-light">
                  <svg
                    class="theme-toggle-icon theme-toggle-sun"
                    width="17"
                    height="16"
                    viewBox="0 0 17 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle cx="8.79932" cy="8" r="4" fill="currentColor"
                    ></circle>
                    <circle
                      class="ray"
                      cx="8.79932"
                      cy="1"
                      r="1"
                      fill="currentColor"></circle>
                    <circle
                      class="ray"
                      cx="8.79932"
                      cy="15"
                      r="1"
                      fill="currentColor"></circle>
                    <circle
                      class="ray"
                      cx="1.79932"
                      cy="8"
                      r="1"
                      fill="currentColor"></circle>
                    <circle
                      class="ray"
                      cx="15.7993"
                      cy="8"
                      r="1"
                      fill="currentColor"></circle>
                    <circle
                      class="ray"
                      cx="3.84927"
                      cy="3.05078"
                      r="1"
                      fill="currentColor"></circle>
                    <circle
                      class="ray"
                      cx="13.7487"
                      cy="12.9503"
                      r="1"
                      fill="currentColor"></circle>
                    <circle
                      class="ray"
                      cx="3.84961"
                      cy="12.9491"
                      r="1"
                      fill="currentColor"></circle>
                    <circle
                      class="ray"
                      cx="13.749"
                      cy="3.04957"
                      r="1"
                      fill="currentColor"></circle>
                  </svg>
                </span>
                <span class="theme-toggle-thumb"></span>
              </span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="mobile-nav">
      <label for="doc-page">Page</label>
      <select id="doc-page" onchange="window.location.href = this.value">
        {
          navItems.map((item) => (
            <option value={item.route} selected={item.route === page.route}>
              {item.title}
            </option>
          ))
        }
      </select>
    </div>

    <div class="shell">
      <aside class="sidebar">
        <nav aria-label="Docs navigation">
          {
            navItems.map((item) => (
              <div class="sidebar-item">
                <a
                  class:list={[
                    'sidebar-link',
                    { active: item.route === page.route },
                  ]}
                  href={item.route}
                  aria-current={item.route === page.route ? 'page' : undefined}
                >
                  {item.title}
                </a>
                {item.route === page.route && page.headings.length > 0 && (
                  <div class="sidebar-nested">
                    {page.headings.map((heading) => (
                      <a
                        class:list={[
                          'sidebar-heading',
                          `level-${heading.level}`,
                        ]}
                        href={`#${heading.id}`}
                      >
                        {heading.title}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </nav>
      </aside>

      <main class="content">
        <div class="content-grid">
          <div class="content-body">
            <slot />
          </div>
          <aside class="page-actions" aria-label="Page actions">
            <div class="page-actions-inner">
              <p class="page-actions-label">Agent actions</p>
              <button
                class="page-action copy-llm"
                type="button"
                data-default-label="Copy for LLM"
                data-copied-label="Copied"
              >
                Copy for LLM
              </button>
              <a class="page-action" href={page.markdownRoute}>
                View as Markdown
              </a>
              <a class="page-action" href={page.sourceUrl} target="_blank">
                Source
              </a>
            </div>
          </aside>
        </div>
      </main>
    </div>
    <script
      id="llm-copy-source"
      is:inline
      type="application/json"
      set:html={llmCopyJson}
    />
    <script
      id="webmcp-docs-context"
      is:inline
      type="application/json"
      set:html={webMcpContext}
    />
    <script is:inline>
      (() => {
        const storageKey = 'dynobox-docs-theme';
        const root = document.documentElement;
        const button = document.querySelector('.theme-toggle');
        if (!(button instanceof HTMLButtonElement)) return;

        const syncLabel = () => {
          const isLight = root.dataset.theme === 'light';
          button.setAttribute('aria-checked', String(isLight));
          button.setAttribute(
            'aria-label',
            isLight ? 'Use dark mode' : 'Use light mode',
          );
          button.title = isLight ? 'Use dark mode' : 'Use light mode';
        };

        syncLabel();
        button.addEventListener('click', () => {
          document.body.style.transition =
            'color 400ms ease, background 300ms ease';
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          localStorage.setItem(storageKey, next);
          syncLabel();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const source = document.querySelector('#llm-copy-source');
        const button = document.querySelector('.copy-llm');
        if (!(source instanceof HTMLScriptElement)) return;
        if (!(button instanceof HTMLButtonElement)) return;

        const copyText = JSON.parse(source.textContent || '""');
        const defaultLabel = button.dataset.defaultLabel || button.textContent;
        const copiedLabel = button.dataset.copiedLabel || 'Copied';

        if (!navigator.clipboard?.writeText) {
          button.disabled = true;
          return;
        }

        const writeClipboard = async (value) => {
          await navigator.clipboard.writeText(value);
        };

        button.addEventListener('click', async () => {
          await writeClipboard(copyText);
          button.textContent = copiedLabel;
          button.classList.add('copied');
          window.setTimeout(() => {
            button.textContent = defaultLabel;
            button.classList.remove('copied');
          }, 1800);
        });
      })();
    </script>
    <script is:inline>
      (() => {
        if (!navigator.clipboard?.writeText) return;

        const copySectionLink = async (anchor) => {
          await navigator.clipboard.writeText(anchor.href);
          anchor.classList.add('copied');
          window.setTimeout(() => {
            anchor.classList.remove('copied');
          }, 1200);
        };

        for (const anchor of document.querySelectorAll('.heading-anchor')) {
          if (!(anchor instanceof HTMLAnchorElement)) continue;
          anchor.addEventListener('click', () => {
            void copySectionLink(anchor);
          });
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const modelContext = navigator.modelContext;
        if (!modelContext?.provideContext && !modelContext?.registerTool) return;

        const contextSource = document.querySelector('#webmcp-docs-context');
        const context =
          contextSource instanceof HTMLScriptElement
            ? JSON.parse(contextSource.textContent || '{"pages":[]}')
            : { pages: [] };
        const pages = Array.isArray(context.pages) ? context.pages : [];
        const pageTitles = pages.map((page) => page.title);

        const asTextContent = (text) => ({
          content: [{ type: 'text', text }],
        });
        const findPage = (title) =>
          pages.find((page) => page.title === title) || pages[0];

        const tools = [
          {
            name: 'get_dynobox_docs_index',
            description:
              'Fetch the machine-readable Dynobox documentation index with pages, topics, headings, and Markdown URLs.',
            inputSchema: {
              type: 'object',
              properties: {},
              additionalProperties: false,
            },
            execute: async () => {
              const response = await fetch('/docs-index.json');
              return asTextContent(await response.text());
            },
          },
          {
            name: 'get_dynobox_doc_markdown',
            description:
              'Fetch one Dynobox documentation page as Markdown for agent-readable answers.',
            inputSchema: {
              type: 'object',
              properties: {
                title: {
                  type: 'string',
                  enum: pageTitles,
                  description: 'Documentation page title to fetch.',
                },
              },
              required: ['title'],
              additionalProperties: false,
            },
            execute: async ({ title }) => {
              const page = findPage(title);
              if (!page) return asTextContent('');

              const response = await fetch(page.markdownRoute);
              return asTextContent(await response.text());
            },
          },
        ];

        if (modelContext.provideContext) {
          modelContext.provideContext({ tools });
          return;
        }

        for (const tool of tools) {
          modelContext.registerTool(tool);
        }
      })();
    </script>
  </body>
</html>

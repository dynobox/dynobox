---
import {Code} from 'astro:components';

import {dynoboxSyntaxTheme} from './syntaxTheme';

const example = `defineDyno({
  // ...
  mcpMocks: {
    linear: {
      tools: {
        get_issue: {
          inputSchema: {type: 'object'},
          response: {content: [{type: 'text', text: 'DYNO-1: Fix login'}]},
        },
        save_issue: {
          inputSchema: {type: 'object'},
          response: {content: []},
        },
      },
    },
  },

  cliMocks: {
    vitest: {
      responses: [
        {exitCode: 1, stderr: 'one test failed'},
        {exitCode: 0, stdout: 'all tests passed'},
      ],
    },
  },

  assertions: [
    mcp.called('linear', 'get_issue', {input: {id: 'DYNO-1'}}),
    mcp.notCalled('linear', 'save_issue'),
  ],
  // ...
});`;
---

<section
  id="boundaries-panel"
  class="explorer-panel"
  role="tabpanel"
  aria-labelledby="boundaries-tab"
  tabindex="0"
  data-explorer-panel
  hidden
>
  <header class="panel-header">
    <span><span class="panel-number">04</span> &middot; mcpMocks &middot; cliMocks &middot; endpoints</span>
    <span class="panel-status">experimental</span>
  </header>
  <div class="panel-content boundary-content">
    <Code code={example} lang="typescript" theme={dynoboxSyntaxTheme} />
    <div class="boundary-notes">
      <p><b>MCP mocks</b> serve fixed tool responses in place of the servers you declare. No real accounts or credentials. Other MCP servers stay as configured.</p>
      <p><b>CLI mocks</b> replace bare executable calls on <code>PATH</code> with static, sequential, or handler responses.</p>
      <p><b>HTTP capture</b> observes child-process traffic that honors the per-job proxy and generated CA.</p>
    </div>
  </div>
</section>

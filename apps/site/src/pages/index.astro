---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
  <main class="shell">
    <section class="hero">
      <div class="hero-copy">
        <h1>Agents deserve <span class="accent">test coverage</span> too.</h1>
        <p>
          Write scenarios in TypeScript or YAML, run them against Claude Code
          and Codex. Assert on real behavior — not just the final answer.
        </p>

        <div class="install">
          <code><span class="prompt">$</span> npm install -g dynobox</code>
          <code><span class="prompt">$</span> dynobox init &amp;&amp; dynobox run</code>
        </div>

        <div class="cta-row">
          <a class="cta cta-primary" href="https://docs.dynobox.xyz/getting-started">Get started</a>
          <a class="cta" href="https://github.com/dynobox/dynobox" target="_blank">View on GitHub</a>
        </div>
      </div>

      <div class="hero-terminal">
        <figure class="landing-terminal" data-dynobox-terminal>
          <div class="landing-terminal-bar">
            <span class="landing-terminal-dot"></span>
            <span class="landing-terminal-dot"></span>
            <span class="landing-terminal-dot"></span>
            <span class="landing-terminal-title">~/dynobox/skills — dynobox</span>
            <button class="landing-terminal-replay" type="button" data-terminal-replay>
              replay
            </button>
          </div>
          <code class="landing-terminal-screen is-art" data-terminal-screen></code>
        </figure>
      </div>
    </section>

    <footer class="footer">
      <a href="https://x.com/dynobox_xyz" target="_blank">@dynobox_xyz</a>
      <a href="mailto:inbox@dynobox.xyz">inbox@dynobox.xyz</a>
    </footer>
  </main>
</SiteLayout>

<style is:global>
  .landing-terminal {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    background: var(--code);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.3);
  }

  .landing-terminal-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line-soft);
    background:
      radial-gradient(ellipse 85% 180% at 24% 0%, rgba(224, 56, 45, 0.16), transparent 72%),
      rgba(17, 19, 24, 0.92);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .landing-terminal-dot {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--line);
  }

  .landing-terminal-title {
    margin: 0 auto;
    color: var(--muted);
  }

  .landing-terminal-replay {
    margin-left: auto;
    padding: 4px 0 4px 8px;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 11px;
  }

  .landing-terminal-replay:hover,
  .landing-terminal-replay:focus-visible {
    color: var(--text);
  }

  .landing-terminal-screen {
    display: block;
    height: clamp(410px, 42vw, 472px);
    margin: 0;
    padding: 20px 22px;
    overflow-x: auto;
    overflow-y: hidden;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: clamp(10.5px, 0.95vw, 11.5px);
    line-height: 1.48;
    text-align: left;
    white-space: pre;
  }

  .landing-terminal-screen.is-art {
    display: grid;
    place-items: center;
  }

  .terminal-glyph-grid {
    display: block;
    width: max-content;
    line-height: 1;
  }

  .terminal-cursor {
    display: inline-block;
    width: 8px;
    height: 14px;
    background: var(--accent);
    vertical-align: -2px;
    animation: terminal-blink 1.1s steps(1) infinite;
  }

  .terminal-red {
    color: var(--accent);
  }

  .terminal-green {
    color: var(--term-green);
  }

  .terminal-dim {
    color: var(--muted);
  }

  .terminal-white {
    color: var(--text);
  }

  .terminal-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 3px;
  }

  .terminal-link:hover,
  .terminal-link:focus-visible {
    color: var(--accent);
  }

  @keyframes terminal-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .landing-terminal-title {
      display: none;
    }

    .landing-terminal-screen {
      height: 392px;
      padding: 14px;
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor {
      animation: none;
    }
  }

  @media (min-width: 901px) {
    .hero {
      grid-template-columns: minmax(300px, 420px) minmax(0, 1fr);
    }

    .hero-copy {
      max-width: 420px;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-dynobox-terminal]');
    const screen = root?.querySelector('[data-terminal-screen]');
    const replay = root?.querySelector('[data-terminal-replay]');

    if (!(screen instanceof HTMLElement) || !(replay instanceof HTMLButtonElement)) {
      return;
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const C = {
      red: '<span class="terminal-red">',
      green: '<span class="terminal-green">',
      dim: '<span class="terminal-dim">',
      white: '<span class="terminal-white">',
      end: '</span>',
    };
    const STAGE = {cols: 70, rows: 30, cx: 34, cy: 14, hw: 11, hh: 7, cursorX: 2, cursorY: 0};
    const BOX = {
      left: STAGE.cx - STAGE.hw,
      right: STAGE.cx + STAGE.hw,
      top: STAGE.cy - STAGE.hh,
      bottom: STAGE.cy + STAGE.hh,
    };
    const COMMAND = 'npx dynobox run --save-run';
    const RUN_URL = 'https://dash.dynobox.xyz/runs/b5e32064-f4c8-42ac-811e-a8d5b5acefe7';
    const SPIN = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧'];
    const JOBS = [
      {
        group: '[dyno-from-skill]',
        title: 'generates test dyno',
        scenario: 'create dyno from skill',
        name: 'claude-code/sonnet/default',
        assertions: '✓ 13 assertions',
        duration: '1m05s',
      },
      {name: 'codex/gpt-5.4-mini/default', assertions: '✓ 13 assertions', duration: '1m58s'},
      {
        group: '[dyno-run-debug]',
        title: 'diagnoses failed run',
        scenario: 'diagnose failed validation',
        name: 'claude-code/sonnet/default',
        assertions: '✓ 11 assertions',
        duration: '2m05s',
      },
      {name: 'codex/gpt-5.4-mini/default', assertions: '✓ 11 assertions', duration: '1m44s'},
      {
        scenario: 'apply approved fix',
        name: 'claude-code/sonnet/default',
        assertions: '✓ 9 assertions ',
        duration: '1m04s',
      },
      {name: 'codex/gpt-5.4-mini/default', assertions: '✓ 9 assertions ', duration: '24.7s'},
    ];

    let timeouts = [];
    let raf = null;
    let token = 0;

    const sleep = (ms) =>
      new Promise((resolve) => {
        const id = window.setTimeout(resolve, ms);
        timeouts.push(id);
      });
    const clamp = (x) => Math.max(0, Math.min(1, x));
    const smooth = (x) => {
      const t = clamp(x);
      return t * t * (3 - 2 * t);
    };
    const easeOut = (x) => {
      const t = clamp(x);
      return 1 - (1 - t) ** 3;
    };
    const easeInOut = (x) => {
      const t = clamp(x);
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    };
    const lerp = (a, b, t) => a + (b - a) * t;

    function resetPlayback() {
      token += 1;
      timeouts.forEach(clearTimeout);
      timeouts = [];
      if (raf !== null) {
        cancelAnimationFrame(raf);
        raf = null;
      }
    }

    function createGrid() {
      return Array.from({length: STAGE.rows}, () => Array(STAGE.cols).fill(' '));
    }

    function plot(grid, x, y, ch = '█') {
      const col = Math.round(x);
      const row = Math.round(y);
      if (col < 0 || col >= STAGE.cols || row < 0 || row >= STAGE.rows) return;
      grid[row][col] = ch;
    }

    function h(grid, y, x0, x1, ch = '█') {
      for (let x = x0; x <= x1; x += 1) plot(grid, x, y, ch);
    }

    function v(grid, x, y0, y1, ch = '█') {
      for (let y = y0; y <= y1; y += 1) plot(grid, x, y, ch);
    }

    function outline(grid, b = BOX, ch = '█') {
      h(grid, b.top, b.left, b.right, ch);
      h(grid, b.bottom, b.left, b.right, ch);
      v(grid, b.left, b.top, b.bottom, ch);
      v(grid, b.right, b.top, b.bottom, ch);
    }

    function solid(grid, cx, cy, hw, hh, ch = '█') {
      const left = Math.round(cx - hw);
      const right = Math.round(cx + hw);
      const top = Math.round(cy - hh);
      const bottom = Math.round(cy + hh);
      for (let y = top; y <= bottom; y += 1) {
        for (let x = left; x <= right; x += 1) plot(grid, x, y, ch);
      }
    }

    function renderGrid(grid) {
      screen.classList.add('is-art');
      screen.innerHTML = `<span class="terminal-glyph-grid terminal-red">${grid
        .map((row) => row.join(''))
        .join('\n')}</span>`;
    }

    function renderText(html) {
      screen.classList.remove('is-art');
      screen.innerHTML = html;
    }

    function animate(duration, draw, currentToken) {
      const start = performance.now();
      return new Promise((resolve) => {
        const step = (now) => {
          if (currentToken !== token) {
            resolve();
            return;
          }
          const progress = clamp((now - start) / duration);
          draw(progress);
          if (progress < 1) {
            raf = requestAnimationFrame(step);
          } else {
            raf = null;
            resolve();
          }
        };
        raf = requestAnimationFrame(step);
      });
    }

    async function playIntro(currentToken) {
      await animate(
        460,
        (progress) => {
          const grid = createGrid();
          const half = Math.round(STAGE.hw * easeOut(progress));
          h(grid, STAGE.cy, STAGE.cx - half, STAGE.cx + half);
          renderGrid(grid);
        },
        currentToken,
      );

      await animate(
        420,
        (progress) => {
          const grid = createGrid();
          const offset = Math.round(STAGE.hh * smooth(progress));
          h(grid, STAGE.cy - offset, BOX.left, BOX.right);
          h(grid, STAGE.cy + offset, BOX.left, BOX.right);
          if (offset > 0) {
            plot(grid, BOX.left, STAGE.cy, '·');
            plot(grid, BOX.right, STAGE.cy, '·');
          }
          renderGrid(grid);
        },
        currentToken,
      );

      await animate(
        380,
        (progress) => {
          const grid = createGrid();
          h(grid, BOX.top, BOX.left, BOX.right);
          h(grid, BOX.bottom, BOX.left, BOX.right);
          const reach = Math.round(STAGE.hh * easeOut(progress));
          v(grid, BOX.left, STAGE.cy - reach, STAGE.cy + reach);
          v(grid, BOX.right, STAGE.cy - reach, STAGE.cy + reach);
          renderGrid(grid);
        },
        currentToken,
      );

      for (let i = 0; i < 5; i += 1) {
        if (currentToken !== token) return;
        const grid = createGrid();
        outline(grid);
        renderGrid(grid);
        await sleep(68);
      }

      await animate(
        200,
        (progress) => {
          const grid = createGrid();
          const t = easeInOut(progress);
          const insetX = Math.round(lerp(0, 3, t));
          const insetY = Math.round(lerp(0, 2, t));
          outline(grid, {
            left: BOX.left + insetX,
            right: BOX.right - insetX,
            top: BOX.top + insetY,
            bottom: BOX.bottom - insetY,
          });
          renderGrid(grid);
        },
        currentToken,
      );

      await animate(
        150,
        (progress) => {
          const grid = createGrid();
          const t = smooth(progress);
          solid(grid, STAGE.cx, STAGE.cy, lerp(STAGE.hw - 3, 3, t), lerp(STAGE.hh - 2, 2, t));
          renderGrid(grid);
        },
        currentToken,
      );

      for (let i = 0; i < 2; i += 1) {
        if (currentToken !== token) return;
        const grid = createGrid();
        solid(grid, STAGE.cx, STAGE.cy, 3, 2);
        renderGrid(grid);
        await sleep(52);
      }

      await animate(
        430,
        (progress) => {
          const grid = createGrid();
          const t = easeInOut(progress);
          solid(
            grid,
            lerp(STAGE.cx, STAGE.cursorX, t),
            lerp(STAGE.cy, STAGE.cursorY, t),
            lerp(3, 0.3, t),
            lerp(2, 0.3, t),
          );
          renderGrid(grid);
        },
        currentToken,
      );
    }

    function promptHtml(text = '', withCursor = true) {
      return `${C.red}❯${C.end} ${C.white}${text}${C.end}${
        withCursor ? '<span class="terminal-cursor"></span>' : ''
      }`;
    }

    function jobResult(job) {
      return `${C.green}${job.assertions}${C.end}                    ${C.dim}${job.duration}${C.end}`;
    }

    function jobName(job) {
      return job.name.padEnd(29, ' ');
    }

    function runLink() {
      return `<a class="terminal-link" href="${RUN_URL}" target="_blank" rel="noreferrer">${RUN_URL}</a>`;
    }

    async function typeCommand(currentToken) {
      renderText(`${C.red}❯${C.end} <span class="terminal-cursor"></span>`);
      await sleep(650);
      let text = '';
      for (const ch of COMMAND) {
        if (currentToken !== token) return;
        text += ch;
        renderText(promptHtml(text));
        await sleep(40);
      }
      await sleep(240);
    }

    async function runTerminal(currentToken) {
      const lines = [
        `${C.red}❯${C.end} ${C.white}${COMMAND}${C.end}`,
        `  ${C.red}■${C.end} ${C.white}dynobox${C.end}  ${C.dim}0.8.0${C.end}`,
        `  ${C.dim}discovered 2 dynos · 3 scenarios · harnesses: 2${C.end}`,
      ];
      const commit = () => renderText(`${lines.join('\n')}\n`);
      commit();
      await sleep(240);

      for (const job of JOBS) {
        if (currentToken !== token) return;
        if (job.group) {
          lines.push('');
          lines.push(`  ${C.dim}${job.group}${C.end} ${C.white}${job.title}${C.end}`);
          commit();
          await sleep(120);
        }
        if (job.scenario) {
          lines.push(`    ${job.scenario}`);
          commit();
          await sleep(100);
        }

        const idx = lines.length;
        lines.push('');
        for (let i = 0; i < 5; i += 1) {
          if (currentToken !== token) return;
          lines[idx] = `      ${C.dim}${jobName(job)}${C.end} ${C.red}${SPIN[i % SPIN.length]}${C.end}`;
          commit();
          await sleep(88);
        }

        lines[idx] = `      ${C.dim}${jobName(job)}${C.end} ${jobResult(job)}`;
        commit();
        await sleep(140);
      }

      lines.push('');
      lines.push(`  ${C.dim}────────────────────────────────────────────────────────${C.end}`);
      lines.push(`  ${C.green}✓ 6 jobs passed${C.end} · ${C.white}66 assertions${C.end} · ${C.dim}8m21s${C.end}`);
      lines.push(`  ${C.dim}saved run:${C.end} ${runLink()}`);
      lines.push('');
      lines.push(`${C.dim}~/dynobox/skills${C.end} ${C.red}❯${C.end} <span class="terminal-cursor"></span>`);
      renderText(lines.join('\n'));
    }

    function finalState() {
      const lines = [
        `${C.red}❯${C.end} ${C.white}${COMMAND}${C.end}`,
        `  ${C.red}■${C.end} ${C.white}dynobox${C.end}  ${C.dim}0.8.0${C.end}`,
        `  ${C.dim}discovered 2 dynos · 3 scenarios · harnesses: 2${C.end}`,
      ];
      for (const job of JOBS) {
        if (job.group) {
          lines.push('');
          lines.push(`  ${C.dim}${job.group}${C.end} ${C.white}${job.title}${C.end}`);
        }
        if (job.scenario) lines.push(`    ${job.scenario}`);
        lines.push(`      ${C.dim}${jobName(job)}${C.end} ${jobResult(job)}`);
      }
      lines.push('');
      lines.push(`  ${C.dim}────────────────────────────────────────────────────────${C.end}`);
      lines.push(`  ${C.green}✓ 6 jobs passed${C.end} · ${C.white}66 assertions${C.end} · ${C.dim}8m21s${C.end}`);
      lines.push(`  ${C.dim}saved run:${C.end} ${runLink()}`);
      lines.push('');
      lines.push(`${C.dim}~/dynobox/skills${C.end} ${C.red}❯${C.end} <span class="terminal-cursor"></span>`);
      renderText(lines.join('\n'));
    }

    async function play() {
      resetPlayback();
      const currentToken = token;
      replay.disabled = true;
      if (reducedMotion) {
        finalState();
        replay.disabled = false;
        return;
      }
      await playIntro(currentToken);
      if (currentToken !== token) return;
      await typeCommand(currentToken);
      if (currentToken !== token) return;
      await runTerminal(currentToken);
      replay.disabled = false;
    }

    replay.addEventListener('click', play);
    play();
  })();
</script>

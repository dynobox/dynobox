{
  "name": "dynobox-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "dynobox monorepo — cross-harness testing for multi-step agent flows",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "validate": "pnpm run format && pnpm run lint",
    "dynolocal": "sh -c 'cd \"$INIT_CWD\" && DYNOBOX_API_URL=http://localhost:8787 tsx \"$OLDPWD/packages/cli/src/bin.ts\" \"$@\"' --",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,cts,mts,tsx,jsx,json}\"",
    "format:write": "prettier --write \"**/*.{js,cjs,mjs,ts,cts,mts,tsx,jsx,json}\"",
    "lint": "eslint .",
    "lint:write": "eslint . --fix",
    "test": "pnpm -r test",
    "typecheck": "pnpm run build && pnpm -r typecheck",
    "write": "pnpm run format:write && pnpm run lint:write"
  },
  "devDependencies": {
    "@dynobox/sdk": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.17",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5",
    "zod": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "ws": "8.21.1",
      "body-parser": "2.3.0",
      "brace-expansion": "5.0.7",
      "fast-uri": "3.1.4",
      "yaml": "2.8.4"
    }
  }
}
